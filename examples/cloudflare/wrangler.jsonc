{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "looms-review",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "LOOMS_RUN", "class_name": "LoomsRun" }],
