{
  "name": "@looms/examples",
  "version": "0.0.1",
  "private": true,
  "description": "Small runnable Looms examples",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "echo-agent": "bun run echo-agent.ts",
    "agent-session": "bun run agent-session.ts",
    "workflow": "bun run workflow.ts",
    "approval": "bun run approval.ts",
    "evaluator": "bun run evaluator.ts",
    "evaluator-live": "bun run evaluator-live.ts",
    "custom-module": "bun run custom-module.ts",
    "custom-thread": "bun run custom-thread.ts",
    "all": "bun run echo-agent && bun run agent-session && bun run workflow && bun run approval && bun run evaluator && bun run custom-module && bun run custom-thread",
    "check-types": "bun x tsc -p tsconfig.json --noEmit && bun run cloudflare:types && bun x tsc -p cloudflare/tsconfig.json && bun x tsc -p ax/cloudflare/tsconfig.json",
    "test": "bun test",
    "durable-review": "bun durable-review.ts",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts --include-runtime=false",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc --port 8791",
    "cloudflare:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "ax:local:up": "bun ax/local/scripts/up.ts",
    "ax:local:doctor": "bun ax/local/scripts/doctor.ts",
    "ax:local:smoke": "bun ax/local/scripts/test.ts --recovery",
    "ax:local:test": "bun ax/local/scripts/test.ts --recovery --faults",
    "ax:local:collect": "bun ax/local/scripts/collect.ts",
    "ax:local:down": "bun ax/local/scripts/down.ts",
    "ax:cloudflare:check": "wrangler deploy --dry-run --config ax/cloudflare/wrangler.jsonc",
    "ax:cloudflare:test": "bun ax/local/scripts/cloudflare.ts",
    "ax:local:qualify": "bun ax/local/scripts/test.ts --recovery --faults --egress"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@swirls/looms": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/bun": "^1.3.9",
    "typescript": "7.0.2",
    "wrangler": "^4.131.2"
  }
}
