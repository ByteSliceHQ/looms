{
  "name": "@looms/examples",
  "version": "0.0.0",
  "private": true,
  "description": "Small runnable Looms examples",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "echo-agent": "bun run echo-agent.ts",
    "workflow": "bun run workflow.ts",
    "approval": "bun run approval.ts",
    "custom-module": "bun run custom-module.ts",
    "custom-thread": "bun run custom-thread.ts",
    "all": "bun run echo-agent && bun run workflow && bun run approval && bun run custom-module && bun run custom-thread",
    "check-types": "bun x tsc -p tsconfig.json --noEmit && bun run cloudflare:types && bun x tsc -p cloudflare/tsconfig.json",
    "test": "bun test",
    "durable-review": "bun durable-review.ts",
    "cloudflare:types": "wrangler types --config cloudflare/wrangler.jsonc cloudflare/worker-configuration.d.ts --include-runtime=false",
    "cloudflare:dev": "wrangler dev --config cloudflare/wrangler.jsonc --port 8791",
    "cloudflare:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@looms/agent": "workspace:*",
    "@looms/ai-vercel": "workspace:*",
    "@looms/approval": "workspace:*",
    "@looms/cloudflare": "workspace:*",
    "@looms/core": "workspace:*",
    "@looms/runtime": "workspace:*",
    "@looms/workflow": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/bun": "^1.3.9",
    "typescript": "7.0.2",
    "wrangler": "^4.131.2"
  }
}
