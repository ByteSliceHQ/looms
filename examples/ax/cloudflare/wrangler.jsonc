{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "looms-ax-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "LOOMS_RUN", "class_name": "LoomsRun" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoomsRun"] }],
}
