{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "PORT",
    "DOCS_PORT",
    "HOST",
    "LOOMS_BACKEND",
    "LOOMS_WORKER_URL",
    "LOOMS_S2_ACCESS_TOKEN",
    "LOOMS_S2_BASIN",
    "LOOMS_S2_ENDPOINT",
    "LOOMS_URL",
    "LOOMS_MODEL",
    "OPENROUTER_API_KEY",
    "S2_ACCESS_TOKEN",
    "S2_BASIN",
    "S2_ENDPOINT",
    "S2_LITE_PORT",
    "FLOX_ENV_CACHE",
    "PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "tsconfig.json",
        "package.json",
        "vite.config.ts",
        "wrangler.json"
      ],
      "outputs": ["dist/**", ".output/**"]
    },
    "check-types": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@looms/demo#dev": {
      "dependsOn": ["^build", "@looms/debugger-app#build"],
      "cache": false,
      "persistent": true
    }
  }
}
