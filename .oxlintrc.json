{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/.wrangler/**",
    "**/node_modules/**",
    "**/.flox/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "@stylistic",
      "specifier": "@stylistic/eslint-plugin"
    }
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-error-in-effect-catch": "off",
        "effecttsgo/global-error-in-effect-failure": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "**/scripts/**/*.ts",
        "**/scripts/**/*.tsx",
        "apps/demo/src/verify.ts"
      ],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-error-in-effect-failure": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": ["**/*.config.ts"],
      "rules": {
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": [
        "apps/demo/src/server.ts",
        "packages/debugger/src/server/**/*.ts",
        "packages/s2/src/lite.ts"
      ],
      "rules": {
        "effecttsgo/global-fetch": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": ["packages/core/src/effects.ts"],
      "rules": {
        "effecttsgo/unsafe-effect-type-assertion": "off"
      }
    },
    {
      "files": ["examples/**"],
      "rules": {
        "effecttsgo/global-console": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off"
      }
    },
    {
      "files": [
        "packages/agent/src/**/*.ts",
        "packages/workflow/src/**/*.ts",
        "packages/approval/src/**/*.ts"
      ],
      "excludeFiles": [
        "packages/agent/src/debugger/**",
        "packages/workflow/src/debugger/**",
        "packages/approval/src/debugger/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Import React from the module debugger entry, not the runtime package."
              },
              {
                "name": "react-dom",
                "message": "Import React from the module debugger entry, not the runtime package."
              },
              {
                "name": "@looms/debugger",
                "message": "Import the debugger kit from the module debugger entry, not the runtime package."
              }
            ],
            "patterns": [
              {
                "group": ["./debugger", "./debugger/*", "../debugger", "../debugger/*"],
                "message": "The package root must not import debugger UI."
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-bare-try-promise": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "curly": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag"]
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "disallowTypeAnnotations": true
      }
    ],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": [
          "multiline-block-like",
          "multiline-expression",
          "multiline-const",
          "multiline-let",
          "multiline-var"
        ]
      },
      {
        "blankLine": "always",
        "prev": [
          "multiline-block-like",
          "multiline-expression",
          "multiline-const",
          "multiline-let",
          "multiline-var"
        ],
        "next": "*"
      }
    ]
  }
}
