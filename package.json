{
  "name": "looms",
  "version": "0.0.1",
  "private": true,
  "description": "Pluggable event-sourced thread runtime",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git"
  },
  "workspaces": [
    "apps/*",
    "examples",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint . --deny-warnings",
    "doctor": "react-doctor --verbose -y",
    "test": "turbo run test",
    "test:e2e:npm": "bun run scripts/e2e-npm-package.ts",
    "verify": "turbo run build --filter=@swirls/looms... && turbo run check-types && turbo run test && bun run lint && bun run fmt:check",
    "dev": "turbo run dev --filter=@looms/demo --filter=@looms/docs",
    "dev:cloudflare": "LOOMS_BACKEND=cloudflare LOOMS_WORKER_URL=http://127.0.0.1:8788 turbo run dev --filter=@looms/demo --filter=@looms/demo-worker",
    "demo": "turbo run dev --filter=@looms/demo",
    "docs": "turbo run dev --filter=@looms/docs",
    "examples": "bun run --filter @looms/examples all",
    "setup:s2": "bash scripts/install-s2-cli.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "check:package": "bun run scripts/check-package.ts",
    "release": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@effect/tsgo": "0.40.0",
    "@looms/core": "workspace:*",
    "@looms/runtime": "workspace:*",
    "@oxlint/plugins": "1.81.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.3.9",
    "effect": "4.0.0-rc.112",
    "oxfmt": "0.67.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "^0.9.14",
    "turbo": "^2.5.8",
    "typescript": "7.0.2",
    "wrangler": "^4.131.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14"
}
