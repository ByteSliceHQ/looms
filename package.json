{
  "name": "looms",
  "private": true,
  "version": "0.0.0",
  "description": "Pluggable event-sourced thread runtime",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "oxlint .",
    "test": "turbo run test",
    "verify": "turbo run build check-types test verify && bun run lint",
    "dev": "turbo run dev --filter=@looms/demo --filter=@looms/docs",
    "demo": "turbo run dev --filter=@looms/demo",
    "docs": "turbo run dev --filter=@looms/docs",
    "setup:s2": "bash scripts/install-s2-cli.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/tsgo": "0.40.0",
    "@looms/core": "workspace:*",
    "@looms/runtime": "workspace:*",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "^1.3.9",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.5.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git"
  }
}
