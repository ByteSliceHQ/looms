# Shared / host defaults (optional). Demo app env lives in apps/demo/.env
PORT=8787
LOOMS_URL=http://127.0.0.1:8787

# Demo + s2-lite — prefer apps/demo/.env
# LOOMS_S2_ACCESS_TOKEN=local
# LOOMS_S2_BASIN=looms-demo
# LOOMS_S2_ENDPOINT=http://127.0.0.1:8080

# Optional secondary index — pass explicitly to postgres() / sqlite()
# DATABASE_URL=postgres://looms@127.0.0.1:5432/looms
