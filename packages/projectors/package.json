{
  "name": "@looms/projectors",
  "version": "0.1.0",
  "description": "Pluggable event projectors and first-party memory, Postgres, and SQLite index helpers",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "import": "./src/postgres.ts",
      "default": "./src/postgres.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "import": "./src/sqlite.ts",
      "default": "./src/sqlite.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "postgres": "^3.4.0",
    "typescript": "7.0.2",
    "@types/bun": "^1.3.9"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./postgres": {
        "types": "./dist/postgres.d.ts",
        "import": "./dist/postgres.js"
      },
      "./sqlite": {
        "types": "./dist/sqlite.d.ts",
        "import": "./dist/sqlite.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/projectors"
  }
}
