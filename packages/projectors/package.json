{
  "name": "@looms/projectors",
  "version": "0.0.1",
  "private": true,
  "description": "Pluggable event projectors and first-party memory, Postgres, and SQLite index helpers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/projectors"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "import": "./src/postgres.ts",
      "default": "./src/postgres.ts"
    },
    "./sqlite": {
      "types": "./src/sqlite.ts",
      "import": "./src/sqlite.ts",
      "default": "./src/sqlite.ts"
    }
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "postgres": "^3.4.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "postgres": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  }
}
