{
  "name": "@looms/testing",
  "version": "0.1.0",
  "description": "Test helpers and module conformance for Looms",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/core": "workspace:*",
    "@looms/runtime": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "fast-check": "^3.23.2",
    "typescript": "7.0.2"
  }
}
