{
  "name": "@looms/ai-vercel",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for Looms LlmAdapter",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/ai-vercel"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/agent": "workspace:*",
    "@looms/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "ai": "^7.0.92",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  }
}
