{
  "name": "@looms/core",
  "version": "0.1.0",
  "description": "Event-sourced thread kernel: envelopes, catalogs, effects, fold, replay, projections",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sqlite-store": {
      "types": "./src/sqlite-store.ts",
      "import": "./src/sqlite-store.ts",
      "default": "./src/sqlite-store.ts"
    },
    "./bun-sqlite": {
      "types": "./src/bun-sqlite.ts",
      "import": "./src/bun-sqlite.ts",
      "default": "./src/bun-sqlite.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./sqlite-store": {
        "types": "./dist/sqlite-store.d.ts",
        "import": "./dist/sqlite-store.js"
      },
      "./bun-sqlite": {
        "types": "./dist/bun-sqlite.d.ts",
        "import": "./dist/bun-sqlite.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@standard-schema/spec": "^1.1.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "7.0.2"
  }
}
