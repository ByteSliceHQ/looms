{
  "name": "@looms/otel",
  "version": "0.0.1",
  "private": true,
  "description": "Optional OpenTelemetry observers for Looms runtime and projector operations",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/projectors": "workspace:*",
    "@looms/runtime": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  }
}
