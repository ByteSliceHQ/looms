  },
  "dependencies": {
    "@looms/core": "workspace:*",
    "@looms/projectors": "workspace:*",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@nats-io/transport-node": "3.4.0",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.13.9",
    "typescript": "7.0.2"
  }
