{
  "name": "@looms/nats",
  "version": "0.0.1",
  "private": true,
  "description": "NATS JetStream projector for Looms",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/nats"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
