{
  "name": "@looms/s2",
  "version": "0.0.1",
  "private": true,
  "description": "S2 streamstore EventStore adapter for Looms",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/s2"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./projector": {
      "types": "./src/projector.ts",
      "import": "./src/projector.ts",
      "default": "./src/projector.ts"
    }
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/core": "workspace:*",
    "@looms/projectors": "workspace:*",
    "@s2-dev/streamstore": "^0.23.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^22.13.9",
    "typescript": "7.0.2"
  }
}
