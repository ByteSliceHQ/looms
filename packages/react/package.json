{
  "name": "@looms/react",
  "version": "0.1.0",
  "description": "React bindings and client run store for Looms",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/client": "workspace:*",
    "@looms/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "19",
    "react-dom": "19",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
