{
  "name": "@looms/debugger",
  "version": "0.0.1",
  "private": true,
  "description": "Domain-agnostic debugger kit and static host for Looms",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/debugger"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/client": "workspace:*",
    "@looms/core": "workspace:*",
    "@looms/react": "workspace:*",
    "@tanstack/react-virtual": "^3.14.11",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "4.0.0-rc.112",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^4.13.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
