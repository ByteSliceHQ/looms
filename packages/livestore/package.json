{
  "name": "@looms/livestore",
  "version": "0.1.0",
  "description": "Opinionated LiveStore schema, React bindings, and light materializers for Looms",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts",
      "default": "./src/react.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@livestore/adapter-web": "0.5.0-dev.0",
    "@livestore/common": "0.5.0-dev.0",
    "@livestore/livestore": "0.5.0-dev.0",
    "@livestore/peer-deps": "0.5.0-dev.0",
    "@livestore/react": "0.5.0-dev.0",
    "@livestore/utils": "0.5.0-dev.0",
    "@livestore/wa-sqlite": "0.5.0-dev.0",
    "@looms/core": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "19",
    "react-dom": "19",
    "typescript": "7.0.2",
    "@types/bun": "^1.3.9"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/livestore"
  }
}
