{
  "name": "@looms/cli",
  "version": "0.0.1",
  "private": true,
  "description": "Looms command-line interface",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteSliceHQ/looms.git",
    "directory": "packages/cli"
  },
  "bin": {
    "looms": "./src/cli.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.build.json",
    "check-types": "bun x tsc -p tsconfig.build.json --noEmit",
    "test": "bun test src",
    "looms": "bun run src/cli.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@looms/agent": "workspace:*",
    "@looms/approval": "workspace:*",
    "@looms/client": "workspace:*",
    "@looms/core": "workspace:*",
    "@looms/runtime": "workspace:*",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "7.0.2"
  }
}
