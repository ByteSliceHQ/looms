{
  // Use Effect-patched TypeScript 7 (tsgo) via the TypeScript 7 extension.
  // Requires: typescriptteam.native-preview (see extensions.json).
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript/bin",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],

  // Bun workspace — avoid Cursor's npm script scanner (known false "failed to parse").
  "npm.packageManager": "bun",
  "npm.autoDetect": "off"
}
