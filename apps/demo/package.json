{
  "name": "@looms/demo",
  "version": "0.1.0",
  "private": true,
  "description": "Looms demo runtime with TanStack Start UI and LiveStore + s2-lite sync",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./definitions": {
      "types": "./src/definitions.ts",
      "import": "./src/definitions.ts",
      "default": "./src/definitions.ts"
    },
    "./demo-config": {
      "types": "./src/demo-config.ts",
      "import": "./src/demo-config.ts",
      "default": "./src/demo-config.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "import": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "PORT=8787 bun .output/server/index.mjs",
    "verify": "bun run src/verify.ts",
    "check-types": "bun x tsc -p tsconfig.json --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@looms/actor": "workspace:*",
    "@looms/agent": "workspace:*",
    "@looms/ai-vercel": "workspace:*",
    "@looms/approval": "workspace:*",
    "@looms/client": "workspace:*",
    "@looms/core": "workspace:*",
    "@looms/livestore": "workspace:*",
    "@looms/projectors": "workspace:*",
    "@looms/runtime": "workspace:*",
    "@looms/s2": "workspace:*",
    "@looms/workflow": "workspace:*",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-virtual": "^3.14.11",
    "ai": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "react": "19",
    "react-dom": "19",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
