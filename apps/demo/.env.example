# Looms demo (apps/demo) — Vite loads this automatically from the app root.
PORT=8787
LOOMS_URL=http://127.0.0.1:8787

# Backend selection: 'bun' (default) or 'cloudflare' (Durable Objects / celld)
# LOOMS_BACKEND=bun
# LOOMS_WORKER_URL=http://127.0.0.1:8788

# In dev, s2-lite auto-starts if installed (or falls back cleanly).
# OpenRouter (optional). Without a key both backends use the stub demo LLM
# (scripted tool calls; replies include raw JSON tool payloads).
# For LOOMS_BACKEND=cloudflare, `bun run dev:cloudflare` loads this file into
# the worker via `wrangler dev --env-file ../demo/.env`.
# OPENROUTER_API_KEY=
# LOOMS_MODEL=openai/gpt-4o-mini

# In production, set these for hosted S2:
# LOOMS_S2_ACCESS_TOKEN=
# LOOMS_S2_BASIN=looms-demo
# LOOMS_S2_ENDPOINT=https://aws-us-east-1.s2.dev
